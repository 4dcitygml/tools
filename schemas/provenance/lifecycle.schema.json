{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lifecycle event (provenance/lifecycle/<event>.json)",
  "description": "One building lifecycle event: a rebuild, split or merge, with its evidence. Factual relationships still require city approval.",
  "type": "object",
  "required": [
    "version",
    "eventId",
    "kind",
    "oldIds",
    "newIds",
    "reason",
    "confirmedOn",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "kind": {
      "enum": [
        "rebuild",
        "split",
        "merge"
      ]
    },
    "oldIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/buildingId"
      }
    },
    "newIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/buildingId"
      }
    },
    "reason": {
      "type": "string",
      "pattern": "\\S"
    },
    "confirmedOn": {
      "$ref": "#/$defs/date"
    },
    "occurredOn": {
      "$ref": "#/$defs/date"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "pattern": "\\S"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://[^/@\\s:]+(:[0-9]+)?(/\\S*)?$"
          }
        }
      }
    }
  },
  "$defs": {
    "buildingId": {
      "type": "string",
      "pattern": "^\\S+$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
